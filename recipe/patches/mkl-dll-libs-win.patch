From 4b130e57f3c540cf9c5b8f851915534c08ce495a Mon Sep 17 00:00:00 2001
From: Xianglong Kong <xkong@anaconda.com>
Date: Wed, 4 Nov 2026 14:14:49 -0600
Subject: [PATCH] Use _dll MKL import libraries on Windows

Use _dll suffixed MKL import library names on Windows.
Conda's mkl-devel 2025+ provides mkl_core_dll.lib instead of mkl_core.lib.
---
 CMakeLists.txt | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1370eed..a7d345c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -414,7 +414,7 @@ if(WITH_MKL)
   endif()
 
   # Find MKL libraries.
-  find_library(MKL_CORE_LIBRARY NAMES mkl_core HINTS ${MKL_ROOT}/lib ${MKL_ROOT}/lib/intel64)
+  find_library(MKL_CORE_LIBRARY NAMES mkl_core mkl_core_dll HINTS ${MKL_ROOT}/lib ${MKL_ROOT}/lib/intel64)
   if(MKL_CORE_LIBRARY)
     get_filename_component(MKL_LIBRARY_DIR ${MKL_CORE_LIBRARY} DIRECTORY)
     message(STATUS "Found MKL library directory: ${MKL_LIBRARY_DIR}")
@@ -425,8 +425,8 @@ if(WITH_MKL)
   add_definitions(-DCT2_WITH_MKL -DMKL_ILP64)
   if(WIN32)
     set(MKL_LIBRARIES
-      ${MKL_LIBRARY_DIR}/mkl_core.lib
-      ${MKL_LIBRARY_DIR}/mkl_intel_ilp64.lib
+      ${MKL_LIBRARY_DIR}/mkl_core_dll.lib
+      ${MKL_LIBRARY_DIR}/mkl_intel_ilp64_dll.lib
       )
   else()
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -m64")
@@ -438,7 +438,7 @@ if(WITH_MKL)
 
   if(OPENMP_RUNTIME STREQUAL "INTEL")
     if(WIN32)
-      list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/mkl_intel_thread.lib)
+      list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/mkl_intel_thread_dll.lib)
     else()
       list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/libmkl_intel_thread.a)
     endif()
@@ -450,7 +450,7 @@ if(WITH_MKL)
     endif()
   elseif(OPENMP_RUNTIME STREQUAL "NONE")
     if(WIN32)
-      list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/mkl_sequential.lib)
+      list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/mkl_sequential_dll.lib)
     else()
       list(APPEND MKL_LIBRARIES ${MKL_LIBRARY_DIR}/libmkl_sequential.a)
     endif()
