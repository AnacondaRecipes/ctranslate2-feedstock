From 997140846674779e4519af1c64efa0eb4fc809ce Mon Sep 17 00:00:00 2001
From: xkong-anaconda <xkong@anaconda.com>
Date: Wed, 4 Nov 2026 10:05:10 -0600
Subject: [PATCH] Fix CUDA 13 (CCCL 2.8+) compatibility

cub::FpLimits was removed in CCCL 2.8+ (CUDA 13). Use version-guarded
macro CT2_FP_LOWEST(T) with cuda::std::numeric_limits for CUDA 13+,
keeping cub::FpLimits for CUDA 12.

thrust::identity<T> was removed in CCCL 2.8+. Provide a simple
identity functor that works across all CUDA versions.
---
 src/ops/dequantize_gpu.cu | 11 ++++++++++-
 src/ops/topk_gpu.cu       | 18 ++++++++++++++----
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/src/ops/dequantize_gpu.cu b/src/ops/dequantize_gpu.cu
index d14ae7e..fa6ace3 100644
--- a/src/ops/dequantize_gpu.cu
+++ b/src/ops/dequantize_gpu.cu
@@ -2,6 +2,15 @@
 
 #include "cuda/helpers.h"
 
+// thrust::identity<T> was removed in CCCL 2.8+ (CUDA 13).
+// Provide a simple replacement that works across all CUDA versions.
+namespace ctranslate2 {
+  template <typename T>
+  struct identity_func {
+    __device__ __forceinline__ T operator()(const T& x) const { return x; }
+  };
+}
+
 namespace ctranslate2 {
   namespace ops {
 
@@ -69,7 +78,7 @@ namespace ctranslate2 {
 
       if (!activation_type) {
         dequantize_gemm_output_kernel<<<blocks, threads, 0, cuda::get_cuda_stream()>>>(
-          c, a_scales, b_scales, transpose_a, transpose_b, bias, thrust::identity<T>(), y, depth);
+          c, a_scales, b_scales, transpose_a, transpose_b, bias, ctranslate2::identity_func<T>(), y, depth);
 
       } else {
         switch (*activation_type) {
diff --git a/src/ops/topk_gpu.cu b/src/ops/topk_gpu.cu
index cb6b378..d51bb1c 100644
--- a/src/ops/topk_gpu.cu
+++ b/src/ops/topk_gpu.cu
@@ -136,6 +136,16 @@ namespace hipcub {
 }
 #else
 #include <cub/block/block_reduce.cuh>
+#if __CUDACC_VER_MAJOR__ >= 13
+#include <cuda/std/limits>
+#endif
+#endif
+
+// cub::FpLimits<T>::Lowest() was removed in CCCL 2.8+ (CUDA 13).
+#if __CUDACC_VER_MAJOR__ >= 13
+#define CT2_FP_LOWEST(T) cuda::std::numeric_limits<T>::lowest()
+#else
+#define CT2_FP_LOWEST(T) cub::FpLimits<T>::Lowest()
 #endif
 
 namespace fastertransformer {
@@ -157,7 +167,7 @@ namespace fastertransformer {
   template <typename T>
   struct TopK {
     int p = NOT_FOUND;
-    T u = cub::FpLimits<T>::Lowest();
+    T u = CT2_FP_LOWEST(T);
 
     __device__ __forceinline__ void insert(T elem, int elem_id) {
       if (greater(elem, u)) {
@@ -167,7 +177,7 @@ namespace fastertransformer {
     }
 
     __device__ __forceinline__ void init() {
-      u = cub::FpLimits<T>::Lowest();
+      u = CT2_FP_LOWEST(T);
       p = NOT_FOUND;
     }
   };
@@ -213,7 +223,7 @@ namespace fastertransformer {
         topk_tmp_val_buf[index] = total.u;
         // If we found a max, blank out the value in the log prob array before starting the next iteration
         if (total.p != NOT_FOUND)
-          log_probs[total.p] = cub::FpLimits<T>::Lowest();
+          log_probs[total.p] = CT2_FP_LOWEST(T);
       }
       __syncthreads();
     }
@@ -261,7 +271,7 @@ namespace fastertransformer {
         topks[ite] = total;
         // An exhausted reduction has no value to invalidate.
         if (total.p != NOT_FOUND)
-          s_val[total.p] = cub::FpLimits<T>::Lowest();
+          s_val[total.p] = CT2_FP_LOWEST(T);
       }
       __syncthreads();
     }
